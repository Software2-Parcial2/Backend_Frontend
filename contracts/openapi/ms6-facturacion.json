{
  "components": {
    "schemas": {
      "CrearFactura": {
        "properties": {
          "citaId": {
            "format": "uuid",
            "type": "string"
          },
          "monto": {
            "exclusiveMinimum": 0,
            "maximum": 99999999.99,
            "type": "number"
          },
          "pacienteId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "citaId",
          "pacienteId",
          "monto"
        ],
        "type": "object"
      },
      "Factura": {
        "properties": {
          "actualizadaEn": {
            "format": "date-time",
            "type": "string"
          },
          "citaId": {
            "format": "uuid",
            "type": "string"
          },
          "creadaEn": {
            "format": "date-time",
            "type": "string"
          },
          "estado": {
            "enum": [
              "PENDIENTE",
              "PROVISIONAL",
              "CONFIRMADA",
              "ANULADA"
            ],
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "moneda": {
            "example": "BOB",
            "type": "string"
          },
          "monto": {
            "example": "180.00",
            "type": "string"
          },
          "pacienteId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "citaId",
          "pacienteId",
          "monto",
          "moneda",
          "estado"
        ],
        "type": "object"
      },
      "IngresoPeriodo": {
        "properties": {
          "confirmado": {
            "type": "string"
          },
          "facturas": {
            "type": "integer"
          },
          "moneda": {
            "type": "string"
          },
          "periodo": {
            "example": "2026-10",
            "type": "string"
          },
          "provisional": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "PaginaFacturas": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Factura"
            },
            "type": "array"
          },
          "siguiente": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "siguiente"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "properties": {
                "campo": {
                  "type": "string"
                },
                "mensaje": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Facturacion interna (Laravel). Escrito a mano porque Laravel no genera OpenAPI; un test (tests/Feature/OpenApiContratoTest.php) verifica que las rutas del codigo coincidan con este archivo.",
    "title": "ms6-facturacion",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/facturacion/facturas": {
      "get": {
        "description": "Roles: caja, administrador, recepcion, paciente.",
        "parameters": [
          {
            "in": "query",
            "name": "limite",
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaFacturas"
                }
              }
            },
            "description": "Pagina de facturas"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validacion o cursor invalido"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Sin token"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Rol insuficiente o paciente sin vinculo"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Lista facturas (personal: todas; paciente: las suyas)"
      },
      "post": {
        "description": "Roles: caja, administrador, recepcion. Escribe `factura.creada` en el outbox.",
        "parameters": [
          {
            "description": "UUID; ver contracts/idempotency.md",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearFactura"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Factura"
                }
              }
            },
            "description": "Creada",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validacion o Idempotency-Key invalida"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Sin token"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Rol insuficiente"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Cobro vigente existente (COBRO_VIGENTE_EXISTENTE) o peticion en proceso"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Idempotency-Key reutilizada con otra peticion"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Crea una factura PENDIENTE"
      }
    },
    "/api/facturacion/facturas/ingresos": {
      "get": {
        "description": "Roles: caja, administrador. `confirmado` suma CONFIRMADA y `provisional` PROVISIONAL.",
        "parameters": [
          {
            "in": "query",
            "name": "desde",
            "required": true,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "hasta",
            "required": true,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "agrupar",
            "schema": {
              "default": "mes",
              "enum": [
                "dia",
                "mes"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IngresoPeriodo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Ingresos"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validacion"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Sin token"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Rol insuficiente"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Rango mayor a 366 dias (RANGO_EXCEDIDO)"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Ingresos agregados por periodo"
      }
    },
    "/api/facturacion/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "service": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "UP"
          }
        },
        "security": [],
        "summary": "Salud del servicio"
      }
    }
  },
  "servers": [
    {
      "description": "Gateway",
      "url": "http://localhost:8090"
    }
  ]
}
