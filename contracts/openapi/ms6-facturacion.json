{
  "components": {
    "schemas": {
      "ActualizarTarifa": {
        "properties": {
          "monto": {
            "minimum": 0.01,
            "type": "number"
          },
          "nombre": {
            "type": [
              "string",
              "null"
            ]
          },
          "tipo": {
            "enum": [
              "CONSULTA",
              "ESTUDIO"
            ],
            "type": "string"
          },
          "vigenteDesde": {
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "monto"
        ],
        "type": "object"
      },
      "AnularFactura": {
        "properties": {
          "motivo": {
            "maxLength": 300,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "motivo"
        ],
        "type": "object"
      },
      "Balance": {
        "properties": {
          "anulaciones": {
            "type": "integer"
          },
          "cobros": {
            "type": "integer"
          },
          "fecha": {
            "type": "string"
          },
          "moneda": {
            "type": "string"
          },
          "pendiente": {
            "properties": {
              "cargos": {
                "type": "integer"
              },
              "monto": {
                "example": "180.00",
                "type": "string"
              }
            },
            "type": "object"
          },
          "porMetodo": {
            "properties": {
              "EFECTIVO": {
                "example": "180.00",
                "type": "string"
              },
              "POS": {
                "example": "180.00",
                "type": "string"
              },
              "TRANSFERENCIA": {
                "example": "180.00",
                "type": "string"
              }
            },
            "type": "object"
          },
          "totalCobrado": {
            "example": "180.00",
            "type": "string"
          },
          "turno": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Comprobante": {
        "properties": {
          "anulado": {
            "type": "boolean"
          },
          "aviso": {
            "type": "string"
          },
          "cajero": {
            "type": "string"
          },
          "cambio": {
            "example": "180.00",
            "type": "string"
          },
          "cargo": {
            "type": "string"
          },
          "concepto": {
            "type": "string"
          },
          "emitidoEn": {
            "format": "date-time",
            "type": "string"
          },
          "facturaId": {
            "format": "uuid",
            "type": "string"
          },
          "fechaCita": {
            "type": [
              "string",
              "null"
            ]
          },
          "metodo": {
            "type": "string"
          },
          "moneda": {
            "type": "string"
          },
          "numero": {
            "type": "string"
          },
          "paciente": {
            "properties": {
              "id": {
                "type": "string"
              },
              "nombre": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "numeroHistoria": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "recibido": {
            "type": [
              "string",
              "null"
            ]
          },
          "referencia": {
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "example": "180.00",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CrearFactura": {
        "properties": {
          "citaId": {
            "format": "uuid",
            "type": "string"
          },
          "monto": {
            "exclusiveMinimum": 0,
            "maximum": 99999999.99,
            "type": "number"
          },
          "pacienteId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "citaId",
          "pacienteId",
          "monto"
        ],
        "type": "object"
      },
      "CrearTarifa": {
        "properties": {
          "especialidad": {
            "pattern": "^[a-z0-9_]+$",
            "type": "string"
          },
          "monto": {
            "minimum": 0.01,
            "type": "number"
          },
          "nombre": {
            "type": [
              "string",
              "null"
            ]
          },
          "tipo": {
            "enum": [
              "CONSULTA",
              "ESTUDIO"
            ],
            "type": "string"
          },
          "vigenteDesde": {
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "especialidad",
          "monto",
          "vigenteDesde"
        ],
        "type": "object"
      },
      "Factura": {
        "properties": {
          "actualizadaEn": {
            "format": "date-time",
            "type": "string"
          },
          "anuladaEn": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "citaId": {
            "format": "uuid",
            "type": "string"
          },
          "creadaEn": {
            "format": "date-time",
            "type": "string"
          },
          "especialidad": {
            "type": [
              "string",
              "null"
            ]
          },
          "estado": {
            "enum": [
              "PENDIENTE",
              "PROVISIONAL",
              "CONFIRMADA",
              "PAGADA",
              "ANULADA"
            ],
            "type": "string"
          },
          "fechaCita": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "moneda": {
            "example": "BOB",
            "type": "string"
          },
          "monto": {
            "example": "180.00",
            "type": "string"
          },
          "motivoAnulacion": {
            "type": [
              "string",
              "null"
            ]
          },
          "numeroCargo": {
            "example": "CG-20261103-0412",
            "type": "string"
          },
          "pacienteId": {
            "format": "uuid",
            "type": "string"
          },
          "pacienteNombre": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "citaId",
          "pacienteId",
          "monto",
          "moneda",
          "estado"
        ],
        "type": "object"
      },
      "FacturaDetalle": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Factura"
          },
          {
            "properties": {
              "movimientos": {
                "items": {
                  "$ref": "#/components/schemas/MovimientoLedger"
                },
                "type": "array"
              },
              "pago": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Pago"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "type": "object"
          }
        ]
      },
      "IngresoPeriodo": {
        "properties": {
          "confirmado": {
            "type": "string"
          },
          "facturas": {
            "type": "integer"
          },
          "moneda": {
            "type": "string"
          },
          "periodo": {
            "example": "2026-10",
            "type": "string"
          },
          "provisional": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Movimiento": {
        "properties": {
          "cargo": {
            "type": "string"
          },
          "comprobante": {
            "type": [
              "string",
              "null"
            ]
          },
          "en": {
            "format": "date-time",
            "type": "string"
          },
          "estado": {
            "enum": [
              "PAGADO",
              "ANULADO"
            ],
            "type": "string"
          },
          "facturaId": {
            "format": "uuid",
            "type": "string"
          },
          "hora": {
            "example": "10:21",
            "type": "string"
          },
          "metodo": {
            "type": [
              "string",
              "null"
            ]
          },
          "monto": {
            "example": "180.00",
            "type": "string"
          },
          "motivo": {
            "type": [
              "string",
              "null"
            ]
          },
          "paciente": {
            "properties": {
              "id": {
                "type": "string"
              },
              "nombre": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "MovimientoLedger": {
        "properties": {
          "estadoAnterior": {
            "type": [
              "string",
              "null"
            ]
          },
          "estadoNuevo": {
            "type": "string"
          },
          "monto": {
            "example": "180.00",
            "type": "string"
          },
          "ocurridoEn": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PagarFactura": {
        "properties": {
          "metodo": {
            "enum": [
              "EFECTIVO",
              "TRANSFERENCIA",
              "POS"
            ],
            "type": "string"
          },
          "recibido": {
            "description": "Obligatorio en efectivo",
            "type": "number"
          },
          "referencia": {
            "description": "Obligatoria en transferencia y POS",
            "type": "string"
          }
        },
        "required": [
          "metodo"
        ],
        "type": "object"
      },
      "PaginaFacturas": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Factura"
            },
            "type": "array"
          },
          "siguiente": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "siguiente"
        ],
        "type": "object"
      },
      "PaginaMovimientos": {
        "properties": {
          "fecha": {
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Movimiento"
            },
            "type": "array"
          },
          "siguiente": {
            "type": [
              "string",
              "null"
            ]
          },
          "turno": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "siguiente"
        ],
        "type": "object"
      },
      "PaginaTarifas": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Tarifa"
            },
            "type": "array"
          },
          "siguiente": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "siguiente"
        ],
        "type": "object"
      },
      "Pago": {
        "properties": {
          "cajero": {
            "type": "string"
          },
          "cambio": {
            "example": "180.00",
            "type": "string"
          },
          "comprobante": {
            "example": "CI-000873",
            "type": "string"
          },
          "facturaId": {
            "format": "uuid",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "metodo": {
            "enum": [
              "EFECTIVO",
              "TRANSFERENCIA",
              "POS"
            ],
            "type": "string"
          },
          "monto": {
            "example": "180.00",
            "type": "string"
          },
          "pagadoEn": {
            "format": "date-time",
            "type": "string"
          },
          "recibido": {
            "type": [
              "string",
              "null"
            ]
          },
          "referencia": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "PagoRegistrado": {
        "properties": {
          "comprobante": {
            "$ref": "#/components/schemas/Comprobante"
          },
          "factura": {
            "$ref": "#/components/schemas/Factura"
          },
          "pago": {
            "$ref": "#/components/schemas/Pago"
          }
        },
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "properties": {
                "campo": {
                  "type": "string"
                },
                "mensaje": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "type": "object"
      },
      "Tarifa": {
        "properties": {
          "especialidad": {
            "type": "string"
          },
          "estado": {
            "enum": [
              "VIGENTE",
              "PROGRAMADA",
              "HISTORICA"
            ],
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "moneda": {
            "type": "string"
          },
          "monto": {
            "example": "180.00",
            "type": "string"
          },
          "nombre": {
            "type": [
              "string",
              "null"
            ]
          },
          "tipo": {
            "enum": [
              "CONSULTA",
              "ESTUDIO"
            ],
            "type": "string"
          },
          "vigenteDesde": {
            "format": "date",
            "type": "string"
          },
          "vigenteHasta": {
            "format": "date",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Facturacion interna (Laravel). Escrito a mano porque Laravel no genera OpenAPI; un test (tests/Feature/OpenApiContratoTest.php) verifica que las rutas del codigo coincidan con este archivo.",
    "title": "ms6-facturacion",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/facturacion/balance": {
      "get": {
        "description": "Roles: caja, administrador.",
        "parameters": [
          {
            "description": "Dia local de la clinica (AAAA-MM-DD); por defecto hoy",
            "in": "query",
            "name": "fecha",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "turno",
            "schema": {
              "enum": [
                "manana",
                "tarde"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balance"
                }
              }
            },
            "description": "Balance"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validacion"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Sin token"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Rol insuficiente"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Balance de caja de un dia"
      }
    },
    "/api/facturacion/facturas": {
      "get": {
        "description": "Roles: caja, administrador, recepcion, paciente.",
        "parameters": [
          {
            "in": "query",
            "name": "limite",
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Lista separada por comas: PROVISIONAL,CONFIRMADA",
            "in": "query",
            "name": "estado",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Atajo: PENDIENTE, PROVISIONAL y CONFIRMADA",
            "in": "query",
            "name": "porCobrar",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "desde",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "hasta",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "N.° de cargo o nombre del paciente",
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "citaId",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Solo personal",
            "in": "query",
            "name": "pacienteId",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaFacturas"
                }
              }
            },
            "description": "Pagina de facturas"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validacion o cursor invalido"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Sin token"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Rol insuficiente o paciente sin vinculo"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Lista facturas (personal: todas; paciente: las suyas)"
      },
      "post": {
        "description": "Roles: caja, administrador, recepcion. Escribe `factura.creada` en el outbox.",
        "parameters": [
          {
            "description": "UUID; ver contracts/idempotency.md",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearFactura"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Factura"
                }
              }
            },
            "description": "Creada",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validacion o Idempotency-Key invalida"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Sin token"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Rol insuficiente"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Cobro vigente existente (COBRO_VIGENTE_EXISTENTE) o peticion en proceso"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Idempotency-Key reutilizada con otra peticion"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Crea una factura PENDIENTE"
      }
    },
    "/api/facturacion/facturas/ingresos": {
      "get": {
        "description": "Roles: caja, administrador. `confirmado` suma CONFIRMADA y `provisional` PROVISIONAL.",
        "parameters": [
          {
            "in": "query",
            "name": "desde",
            "required": true,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "hasta",
            "required": true,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "agrupar",
            "schema": {
              "default": "mes",
              "enum": [
                "dia",
                "mes",
                "especialidad"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IngresoPeriodo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Ingresos"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validacion"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
