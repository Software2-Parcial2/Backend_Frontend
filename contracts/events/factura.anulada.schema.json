{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigec.local/contracts/events/factura.anulada.schema.json",
  "title": "factura.anulada",
  "description": "Evento de dominio MS6 -> varios (exchange sigec.eventos). Un cargo fue anulado manualmente en caja (no por la SAGA).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "factura.anulada"
        },
        "payload": {
          "type": "object",
          "required": [
            "facturaId",
            "citaId",
            "pacienteId",
            "monto",
            "motivo",
            "estabaPagada"
          ],
          "additionalProperties": false,
          "properties": {
            "facturaId": {
              "type": "string",
              "format": "uuid"
            },
            "citaId": {
              "type": "string",
              "format": "uuid"
            },
            "pacienteId": {
              "type": "string",
              "format": "uuid"
            },
            "monto": {
              "type": "string",
              "pattern": "^\\d+\\.\\d{2}$",
              "description": "dinero como string decimal (BOB)"
            },
            "motivo": {
              "type": "string"
            },
            "estabaPagada": {
              "type": "boolean"
            }
          }
        }
      }
    }
  ]
}
