# Copia este archivo a .env y cambia los valores. NO subas .env a Git.

POSTGRES_USER=sigec
POSTGRES_PASSWORD=cambia_esto

RABBITMQ_USER=sigec
RABBITMQ_PASSWORD=cambia_esto

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambia_esto

# Cadena larga y aleatoria (por ejemplo: openssl rand -hex 24)
N8N_ENCRYPTION_KEY=cambia_esto

# --- Se usan mas adelante por los servicios ---
KEYCLOAK_ISSUER=http://localhost:8080/realms/sigec
RABBITMQ_URL=amqp://sigec:cambia_esto@localhost:5672
DYNAMODB_ENDPOINT=http://localhost:8000
# Puerto del host de DynamoDB Local (cambialo si el 8000 esta ocupado; ajusta tambien DYNAMODB_ENDPOINT)
DYNAMODB_HOST_PORT=8000
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
S3_ENDPOINT=http://localhost:9000
MONGO_URL=mongodb://localhost:27017/sigec_imagenes
# Puerto del host de MongoDB (cambialo si el 27017 esta ocupado por otro proyecto; ajusta tambien MONGO_URL)
MONGO_HOST_PORT=27017
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Cuentas de servicio de Keycloak (cliente confidencial). Cadena larga y aleatoria (openssl rand -hex 24) ---
#   MS1: administracion de usuarios/roles/sesiones (ms1-identidad).  MS7: agentes de monitoreo programados (sin esto solo corren a mano).
#   Se crean en Keycloak con `make keycloak-aplicar` (se niega a usar un secreto vacio o `cambia_esto`).
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sigec
MS1_CLIENT_ID=sigec-identidad
MS1_CLIENT_SECRET=cambia_esto
MS7_CLIENT_ID=sigec-ms7
MS7_CLIENT_SECRET=cambia_esto
# MS1: a donde vuelve el paciente tras activar su cuenta desde el correo de invitacion (y cuanto dura el enlace).
PWA_URL=http://localhost:5174/
INVITACION_VIDA_SEGUNDOS=259200

# --- Notificaciones (MS8 + n8n). Los secretos reales van SOLO en .env ---
# Secretos compartidos (cadena larga y aleatoria, p. ej. openssl rand -hex 24):
#   N8N_WEBHOOK_SECRET: MS8 -> webhooks de n8n.   MS8_INTERNAL_SECRET: n8n -> endpoints /internal de MS8.
N8N_WEBHOOK_SECRET=cambia_esto
MS8_INTERNAL_SECRET=cambia_esto
# Mailtrap (Email Testing). API token e id del inbox: https://mailtrap.io -> Email Testing -> Inboxes -> API
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAILTRAP_ACCOUNT_ID=
MAIL_FROM=no-reply@sigec.test
# Sin MAILTRAP_INBOX_ID n8n usa Email Sending (envio real): MAILTRAP_API_URL=https://send.api.mailtrap.io y MAIL_FROM del dominio
# verificado (o hello@demomailtrap.co, que solo entrega al correo del duenio). Con inbox id usa el sandbox (por defecto).
MAILTRAP_API_URL=
# SMTP de Keycloak ("Olvide mi contrasena", activacion de cuentas). Se aplica con `make keycloak-aplicar`.
#   Mailtrap Email Sending (envio real): host live.smtp.mailtrap.io, puerto 587, usuario `api`, contrasena = API token de Sending.
#     Con el dominio de prueba (demomailtrap.co) el remitente debe ser hello@demomailtrap.co y solo llega al correo del duenio de la cuenta.
#   Mailtrap Email Testing (sandbox): host sandbox.smtp.mailtrap.io, puerto 2525, usuario/contrasena de Inbox -> SMTP Settings.
KC_SMTP_HOST=live.smtp.mailtrap.io
KC_SMTP_PORT=587
KC_SMTP_USER=api
KC_SMTP_PASSWORD=
KC_SMTP_FROM=hello@demomailtrap.co
# Bot de Telegram (BotFather). TELEGRAM_ALERT_CHAT_ID = chat de administradores que recibe las alertas internas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALERT_CHAT_ID=
# MS8: n8n (canal real) o simulated (solo pruebas / e2e de la SAGA)
N8N_BASE_URL=http://localhost:5678
NOTIF_SENDER=n8n

# --- Almacenamiento S3 local (SeaweedFS con autenticacion; en AWS se usa S3 real) ---
S3_ACCESS_KEY=cambia_esto
S3_SECRET_KEY=cambia_esto
S3_BUCKET_RADIOGRAFIAS=radiografias

# --- MS7 ML (FastAPI, puerto 8007). Si se define, la API de MS7 debe enviar X-Api-Key con este valor ---
ML_API_KEY=

# --- MS7 API (NestJS, 3007): servicios aguas abajo y limites de GraphQL ---
MS3_URL=http://localhost:3003
MS6_URL=http://localhost:8006
ML_URL=http://localhost:8007
MS7_HTTP_TIMEOUT_MS=8000
GRAPHQL_MAX_DEPTH=6
GRAPHQL_MAX_COMPLEXITY=120

# --- MS7: agente de IA (nube). LLM_PROVIDER = gemini (por defecto) | claude | simulated (sin API, para pruebas/E2E) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AGENTE_MAX_ITERACIONES=5
AGENTE_TIMEOUT_MS=30000
AGENTE_MAX_LLAMADAS_TURNO=4
AGENTE_MAX_CONSULTAS_HORA=30

# --- MS7: RAG (pgvector) y servicio de embeddings (puerto 8027) ---
EMBEDDINGS_URL=http://localhost:8027
EMBEDDINGS_API_KEY=
# MS7_DATABASE_URL=postgres://usuario:clave@localhost:5432/ms7_inteligencia   (por defecto usa POSTGRES_* y la base ms7_inteligencia)
RAG_AUTO_MIGRATE=true
RAG_CHUNK_CHARS=480
RAG_SOLAPE=80
RAG_SCORE_MINIMO=0.3

# Puerto del host para PostgreSQL (cambialo si el 5432 esta ocupado por otro proyecto; ajusta tambien DB_PORT/POSTGRES_PORT/MS7_DATABASE_URL)
POSTGRES_HOST_PORT=5432
WHISPER_URL=http://localhost:8017
WHISPER_API_KEY=
WHISPER_MODEL=small

# --- Frontends: base del gateway (los remotos la reciben del shell en mount(); sin esto usan http://localhost:8090) ---
# Shell (Rsbuild): PUBLIC_API_URL.  PWA y remoto Vue en modo independiente (Vite): VITE_API_URL.  App movil (Expo): EXPO_PUBLIC_API_URL
#   (emulador Android: http://10.0.2.2:8090; dispositivo fisico: la IP de tu maquina; el issuer de Keycloak que ve el dispositivo
#   debe coincidir con KEYCLOAK_ISSUER de los servicios).
PUBLIC_API_URL=http://localhost:8090
# Shell: manifiestos de los remotos (Module Federation 2). Se leen al compilar/arrancar el shell.
PUBLIC_REMOTE_VUE_URL=http://localhost:5175/mf-manifest.json
PUBLIC_REMOTE_ANGULAR_URL=http://localhost:4201/mf-manifest.json
VITE_API_URL=http://localhost:8090
EXPO_PUBLIC_API_URL=http://localhost:8090
