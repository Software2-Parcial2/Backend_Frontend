{
  "name": "@sigec/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente HTTP comun de los frontends de SIGEC: problem+json, Idempotency-Key, If-Match/ETag, cursor, X-Correlation-Id, formato de dinero y fechas",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}
